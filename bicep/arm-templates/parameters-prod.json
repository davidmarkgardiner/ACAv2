{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "namePrefix": {
      "value": "funcapp"
    },
    "environment": {
      "value": "prod"
    },
    "location": {
      "value": "eastus"
    },
    "containerImage": {
      "value": "YOUR_REGISTRY.azurecr.io/function-app:v1.0.0"
    },
    "minReplicas": {
      "value": 2
    },
    "maxReplicas": {
      "value": 20
    },
    "cpu": {
      "value": "0.5"
    },
    "memory": {
      "value": "1Gi"
    },
    "tags": {
      "value": {
        "environment": "prod",
        "application": "function-app",
        "managedBy": "arm-template",
        "costCenter": "operations",
        "criticality": "high"
      }
    }
  }
}
